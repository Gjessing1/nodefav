{
  "name": "nodefav",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser bookmark synchronization built around the native bookmark experience.",
  "workspaces": [
    "shared",
    "backend",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:backend": "npm run dev -w @nodefav/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.12.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=24"
  }
}
